DATABASE_URL=postgres://appointment:appointment@localhost:5433/appointment_connector
PUBLIC_BASE_URL=http://localhost:3080
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret

# "Login with Agentblit" (OIDC). Issuer is the console; no URLs are hardcoded.
AGENTBLIT_APP_URL=http://localhost:3000
AGENTBLIT_CLIENT_ID=appointment-connector
# Printed once by `pnpm oauth:seed` in the console repo.
AGENTBLIT_CLIENT_SECRET=

# Google Meet for bookings (unrelated to sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
